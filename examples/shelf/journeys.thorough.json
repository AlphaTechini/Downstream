          "path": "/me/shelf/{{book_id}}",
          "headers": {
            "Authorization": "Bearer {{token_a}}"
          },
          "expect_status": 200
        },
        {
          "name": "a_shelf_add_again",
          "method": "PUT",
          "path": "/me/shelf/{{book_id}}",
          "headers": {
            "Authorization": "Bearer {{token_a}}"
