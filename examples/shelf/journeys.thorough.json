          },
          "expect_status": 400
        },
        {
          "name": "review_rating_high",
          "method": "POST",
          "path": "/books/{{book_id}}/reviews",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "rating": 6,
            "text": "Too high"
          },
          "expect_status": 400
        },
        {
          "name": "review_wrong_type",
          "method": "POST",
          "path": "/books/{{book_id}}/reviews",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "rating": "five"
          },
          "expect_status": 400
        },
        {
          "name": "review_text_oversized",
          "method": "POST",
          "path": "/books/{{book_id}}/reviews",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "rating": 3,
            "text": ""
          },
          "expect_status": 400
        },
        {
          "name": "review_unknown_book",
          "method": "POST",
          "path": "/books/0/reviews",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "rating": 3
          },
          "expect_status": 404
        },
        {
          "name": "review_again",
          "method": "POST",
          "path": "/books/{{book_id}}/reviews",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "rating": 4,
            "text": "Good"
          },
          "expect_status": 201
        },
        {
          "name": "list_reviews",
          "method": "GET",
          "path": "/books/{{book_id}}/reviews",
          "expect_status": 200
        },
        {
          "name": "list_reviews_unknown_book",
          "method": "GET",
          "path": "/books/0/reviews",
          "expect_status": 404
        }
      ]
