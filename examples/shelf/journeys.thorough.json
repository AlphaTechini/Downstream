    {
      "id": "second_reader_cannot_touch_first_shelf",
      "goal": "One reader shelves a book; a second reader views a shelf, shelves a missing book and removes the same book id, and the first shelf is unchanged",
      "why_included": "Adds a second user, repeated-request and negative steps to the owner-scoped shelf; 200 and 404 read from handlers.go, 401 from auth.go",
      "steps": [
        {
          "name": "a_sign_up",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "own_a_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 201
        },
        {
          "name": "a_log_in",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "own_a_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 200,
          "extract": {
            "token_a": "/token"
          }
        },
        {
          "name": "b_sign_up",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
