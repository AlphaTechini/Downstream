{
  "version": 1,
  "journeys": [
    {
      "id": "signup_rejects_bad_input",
      "goal": "A visitor tries to sign up with empty, oversized and wrong-type input, signs up twice, and logs in with wrong details",
      "why_included": "Adds edge-input, negative and repeated-request steps to sign-up and login; statuses read from handlers.go",
      "steps": [
        {
          "name": "signup_empty_username",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "",
            "password": "correct-horse-battery"
          },
          "expect_status": 400
        },
        {
          "name": "signup_oversized_username",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu",
            "password": "correct-horse-battery"
          },
          "expect_status": 400
        },
        {
          "name": "signup_wrong_type",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": 42,
            "password": "correct-horse-battery"
          },
          "expect_status": 400
        },
        {
          "name": "signup_short_password",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "edge_{{uniq}}",
            "password": "short"
          },
          "expect_status": 400
        },
        {
          "name": "sign_up",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "edge_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 201
        },
        {
          "name": "sign_up_again",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "edge_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 409
        },
        {
          "name": "login_wrong_password",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "edge_{{uniq}}",
            "password": "not-the-password"
          },
          "expect_status": 401
        },
        {
          "name": "login_unknown_user",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "nobody_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 401
        },
        {
          "name": "log_in",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "edge_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 200,
          "extract": {
            "token": "/token"
          }
        }
      ]
    },
    {
      "id": "protected_routes_refuse_anonymous",
      "goal": "A reader works normally, then the same calls are sent without a token and with a bad token",
      "why_included": "Adds negative steps for every route behind the token check; 401 for a missing or bad token read from auth.go",
      "steps": [
        {
          "name": "sign_up",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "tok_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 201
        },
        {
          "name": "log_in",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "tok_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 200,
          "extract": {
            "token": "/token"
          }
        },
        {
          "name": "add_book",
          "method": "POST",
          "path": "/books",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "title": "Token Test",
            "author": "A. Writer"
          },
          "expect_status": 201,
          "extract": {
            "book_id": "/id"
          }
        },
        {
          "name": "add_book_no_token",
          "method": "POST",
          "path": "/books",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "title": "No Token",
            "author": "A. Writer"
          },
          "expect_status": 401
        },
        {
          "name": "add_book_bad_token",
          "method": "POST",
          "path": "/books",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer 0000.deadbeef"
          },
          "body": {
            "title": "Bad Token",
            "author": "A. Writer"
          },
          "expect_status": 401
        },
        {
          "name": "add_book_wrong_scheme",
          "method": "POST",
          "path": "/books",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Basic {{token}}"
          },
          "body": {
            "title": "Wrong Scheme",
            "author": "A. Writer"
          },
          "expect_status": 401
        },
        {
          "name": "review_no_token",
          "method": "POST",
          "path": "/books/{{book_id}}/reviews",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "rating": 5
          },
          "expect_status": 401
        },
        {
          "name": "shelf_add_no_token",
          "method": "PUT",
          "path": "/me/shelf/{{book_id}}",
          "expect_status": 401
        },
        {
          "name": "shelf_list_no_token",
          "method": "GET",
          "path": "/me/shelf",
          "expect_status": 401
        },
        {
          "name": "shelf_remove_no_token",
          "method": "DELETE",
          "path": "/me/shelf/{{book_id}}",
          "expect_status": 401
        }
      ]
    },
    {
      "id": "reviewer_sends_bad_reviews",
