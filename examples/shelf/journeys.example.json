          "extract": {
            "book_id": "/id"
          }
        },
        {
          "name": "browse_tag",
          "method": "GET",
          "path": "/books?tag=maps",
          "expect_status": 200
        },
        {
          "name": "open_book",
          "method": "GET",
          "path": "/books/{{book_id}}",
          "expect_status": 200
        }
      ]
    },
