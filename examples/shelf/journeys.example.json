{
  "version": 1,
  "journeys": [
    {
      "id": "new_reader_builds_shelf",
      "goal": "A new reader signs up, logs in, adds a book and puts it on their shelf",
      "why_included": "Covers the sign-up and login routes and the authenticated routes that check the token on every request",
      "steps": [
        {
          "name": "sign_up",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "reader_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 201
        },
        {
          "name": "log_in",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "reader_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 200,
          "extract": {
            "token": "/token"
          }
        },
        {
          "name": "add_book",
          "method": "POST",
          "path": "/books",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "title": "The Long Way Round",
            "author": "A. Writer",
            "tags": [
              "travel",
              "memoir"
            ]
          },
          "expect_status": 201,
          "extract": {
            "book_id": "/id"
          }
        },
        {
          "name": "shelf_add",
          "method": "PUT",
          "path": "/me/shelf/{{book_id}}",
          "headers": {
            "Authorization": "Bearer {{token}}"
          },
          "expect_status": 200
        },
        {
          "name": "shelf_list",
          "method": "GET",
          "path": "/me/shelf",
          "headers": {
            "Authorization": "Bearer {{token}}"
          },
          "expect_status": 200
        }
      ]
    },
    {
      "id": "reader_reviews_book",
      "goal": "A reader logs in, reviews a book and reads the reviews",
      "why_included": "Authenticated write followed by a public read of the same data",
      "steps": [
        {
          "name": "sign_up",
          "method": "POST",
          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "reader_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 201
        },
        {
          "name": "log_in",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "reader_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 200,
          "extract": {
            "token": "/token"
          }
        },
        {
          "name": "add_book",
          "method": "POST",
          "path": "/books",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "title": "Notes on Quiet Mornings",
            "author": "A. Writer",
            "tags": [
              "essays"
            ]
          },
          "expect_status": 201,
          "extract": {
            "book_id": "/id"
          }
        },
        {
          "name": "post_review",
          "method": "POST",
          "path": "/books/{{book_id}}/reviews",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "rating": 4,
            "text": "Short and well written."
          },
          "expect_status": 201
        },
        {
          "name": "read_reviews",
          "method": "GET",
          "path": "/books/{{book_id}}/reviews",
          "expect_status": 200
        }
      ]
    },
    {
      "id": "visitor_browses_by_tag",
      "goal": "A visitor browses books by tag and opens one",
      "why_included": "Public routes only; they share the store with the changed code but never check a token",
