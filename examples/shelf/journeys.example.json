          "path": "/users",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "reader_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 201
        },
        {
          "name": "log_in",
          "method": "POST",
          "path": "/login",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "username": "reader_{{uniq}}",
            "password": "correct-horse-battery"
          },
          "expect_status": 200,
          "extract": {
